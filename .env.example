# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# JWT_SECRET: Clave secreta para firmar tokens JWT de autenticación en TerritorioMix
JWT_SECRET="super_secret_territorio_mix_jwt_key_change_in_production"

# DB_FILE_PATH: Ruta del archivo JSON/SQLite persistente en el servidor
DB_FILE_PATH="./data/territorio_mix_db.json"

# Credenciales iniciales para sembrado (seeding) de base de datos
# Asegúrate de definir contraseñas seguras y robustas en tu archivo .env
ADMIN_EMAIL="admin@territoriomix.org"
ADMIN_PASSWORD="Cambiar_Por_Password_Seguro_Admin_2026!"
USER_EMAIL="censista@territoriomix.org"
USER_PASSWORD="Cambiar_Por_Password_Seguro_User_2026!"

# Configuración de Correo Electrónico (Para restablecer contraseña con Nodemailer)
# Si no se configuran, el servidor genera un enlace de prueba en modo demostración en pantalla/logs
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notificaciones@territoriomix.org"
SMTP_PASS="tu_contraseña_smtp"
SMTP_FROM="TerritorioMix <notificaciones@territoriomix.org>"
